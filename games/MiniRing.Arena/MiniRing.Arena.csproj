<Project Sdk="Microsoft.NET.Sdk">
  <!-- ボット同士を戦わせる対戦場（ヘッドレス）。総当たりの順位表・技の内訳・スタイルの自動調整。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>miniring-arena</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiniRing\MiniRing.csproj" />
    <InternalsVisibleTo Include="MiniRing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 中継の団体のファイル（WVC・VFC・IVF）。名簿 roster/*.json と同じく組み込みにして、実行場所によらず読む。 -->
    <EmbeddedResource Include="Orgs\*.json" LogicalName="MiniRing.Arena.Orgs.%(Filename)%(Extension)" />
    <!-- コマンドの使い方（help・知らないコマンドのときに出す。ArenaUsageTests が switch と合っているかを確かめる）。 -->
    <EmbeddedResource Include="Usage.txt" LogicalName="MiniRing.Arena.Usage.txt" />
    <!-- キャラメイクの画面（maker のコマンドが localhost で出す 1 枚の HTML）。 -->
    <EmbeddedResource Include="Maker\maker.html" LogicalName="MiniRing.Arena.Maker.maker.html" />
    <!-- 団体の王座とランキングの記録（rankings・title のコマンドが書き直す。試合と試合の間にだけ変わる）。 -->
    <EmbeddedResource Include="Orgs\standings\*.json" LogicalName="MiniRing.Arena.Standings.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
