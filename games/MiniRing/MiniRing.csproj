<Project Sdk="Microsoft.NET.Sdk">
  <!-- ゲーム本体（ホスト非依存）。デスクトップ（GameHost）と VR（OpenXR）の両ホストから使う。 -->
  <ItemGroup>
    <EmbeddedResource Include="Motion/SwordFormSkills.json" LogicalName="MiniRing.Motion.SwordFormSkills.json" />
    <!-- VR の稽古の記録から選んだ振り（docs/vrmotion/ の写し）。キャラの教育（weaponBot.VrForms）が型の目標の経路として使う（VrMotionForms）。 -->
    <EmbeddedResource Include="Motion/VrForms/*.vrmotion" LogicalName="MiniRing.Motion.VrForms.%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\Aigis.Foundation\Aigis.Foundation.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Physics\Aigis.Physics.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Render\Aigis.Render.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Player\Aigis.Player.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Audio\Aigis.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MiniRing.Tests" />
    <!-- 対戦場の台本つきの場面（breakdemo: 骨を断つ・折る・武器を折る）が、試合の内側の手（BoxingGame.BreakBone など）を使う。 -->
    <InternalsVisibleTo Include="miniring-arena" />
  </ItemGroup>
  <ItemGroup>
    <!-- ゲームの CPU（champion）のスタイル。値が多い（防御技の表を含む）ので JSON のまま組み込む。docs/BOT_PDCA.md -->
    <EmbeddedResource Include="Bots\karate.json" LogicalName="MiniRing.Bots.karate.json" />
    <EmbeddedResource Include="Bots/taekwondo.json" LogicalName="MiniRing.Bots.taekwondo.json" />
    <EmbeddedResource Include="Bots/muaythai.json" LogicalName="MiniRing.Bots.muaythai.json" />
    <EmbeddedResource Include="Bots/kicks/*.json" LogicalName="MiniRing.Bots.kicks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Bots/tonfa.json" LogicalName="MiniRing.Bots.tonfa.json" />
    <EmbeddedResource Include="Bots/jujutsu.json" LogicalName="MiniRing.Bots.jujutsu.json" />
    <EmbeddedResource Include="Bots\champion.json" LogicalName="MiniRing.Bots.champion.json" />
    <!-- インファイター。回避編で磨いた回避技と、回避からのカウンターの表を持つ（docs/BOT_PDCA.md 回避編）。 -->
    <EmbeddedResource Include="Bots\swarmer.json" LogicalName="MiniRing.Bots.swarmer.json" />
    <!-- 武器の教科書（刀・ロングソード・こんぼうのボットの判断の値。CLAUDE.md §1.8、docs/CHARACTERS.md §5 の weaponBot が差分で重なる）。 -->
    <EmbeddedResource Include="Bots\weapons\*.json" LogicalName="MiniRing.Bots.weapons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Bots\grapple\*.json" LogicalName="MiniRing.Bots.grapple.%(Filename)%(Extension)" />
    <!-- キャラクターの名簿（国籍・武器・肌の色・体格・名前。docs/CHARACTERS.md）。 -->
    <EmbeddedResource Include="Characters\countries.json" LogicalName="MiniRing.Characters.countries.json" />
    <EmbeddedResource Include="Characters\maker.json" LogicalName="MiniRing.Characters.maker.json" />
    <EmbeddedResource Include="Characters\roster\*.json" LogicalName="MiniRing.Characters.roster.%(Filename)%(Extension)" />
    <!-- 顔の部品の表（Codex の参考図から tools/face-parts/build_face_parts.py で作る。docs/CHARACTERS.md §2）。 -->
    <EmbeddedResource Include="Voxels\FaceParts\*.json" LogicalName="MiniRing.Voxels.FaceParts.%(Filename)%(Extension)" />
    <!-- 部屋の素材（CC0。Assets/CREDITS.md）: 家具の OBJ/MTL（Kenney）と色のテクスチャ（ambientCG）。 -->
    <EmbeddedResource Include="Assets\Furniture\*.obj;Assets\Furniture\*.mtl" LogicalName="MiniRing.Assets.Furniture.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Textures\*.png" LogicalName="MiniRing.Assets.Textures.%(Filename)%(Extension)" />
    <!-- UI の文字の美咲フォント（門真なむ氏、フリー・再配布可。Assets/Fonts/misaki_LICENSE.txt・docs/REUSE.md）。描画だけ（試合に響かない）。 -->
    <EmbeddedResource Include="Assets\Fonts\misaki_gothic.ttf" LogicalName="MiniRing.Assets.Fonts.misaki_gothic.ttf" />
    <!-- ボクセル編集ソフト（Vengi など）で直したボクサーの中身。無ければ生成のまま（docs/VOXEL_EDITING.md）。 -->
    <EmbeddedResource Include="Voxels\boxer.vox" LogicalName="MiniRing.Voxels.boxer.vox" Condition="Exists('Voxels\boxer.vox')" />
    <!-- 同じく、直した武器・はめる物の中身（無ければ生成のまま）。組み込むと武器の質量・接触が変わるので PhysicsVersion を上げる。 -->
    <EmbeddedResource Include="Voxels\weapons.vox" LogicalName="MiniRing.Voxels.weapons.vox" Condition="Exists('Voxels\weapons.vox')" />
  </ItemGroup>
</Project>
