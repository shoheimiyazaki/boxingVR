<Project Sdk="Microsoft.NET.Sdk">
  <!-- ゲーム本体（ホスト非依存）。デスクトップ（GameHost）と VR（OpenXR）の両ホストから使う。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Aigis.Foundation\Aigis.Foundation.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Physics\Aigis.Physics.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Render\Aigis.Render.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Player\Aigis.Player.csproj" />
    <ProjectReference Include="..\..\src\Aigis.Audio\Aigis.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MiniRing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ゲームの CPU（champion）のスタイル。値が多い（防御技の表を含む）ので JSON のまま組み込む。docs/BOT_PDCA.md -->
    <EmbeddedResource Include="Bots\champion.json" LogicalName="MiniRing.Bots.champion.json" />
    <!-- インファイター。回避編で磨いた回避技と、回避からのカウンターの表を持つ（docs/BOT_PDCA.md 回避編）。 -->
    <EmbeddedResource Include="Bots\swarmer.json" LogicalName="MiniRing.Bots.swarmer.json" />
    <!-- 部屋の素材（CC0。Assets/CREDITS.md）: 家具の OBJ/MTL（Kenney）と色のテクスチャ（ambientCG）。 -->
    <EmbeddedResource Include="Assets\Furniture\*.obj;Assets\Furniture\*.mtl" LogicalName="MiniRing.Assets.Furniture.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Textures\*.png" LogicalName="MiniRing.Assets.Textures.%(Filename)%(Extension)" />
    <!-- ボクセル編集ソフト（Vengi など）で直したボクサーの中身。無ければ生成のまま（docs/VOXEL_EDITING.md）。 -->
    <EmbeddedResource Include="Voxels\boxer.vox" LogicalName="MiniRing.Voxels.boxer.vox" Condition="Exists('Voxels\boxer.vox')" />
  </ItemGroup>
</Project>
