<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Silk.NET.OpenAL's buffer upload is a pointer API; confined to OpenAlAudioBackend.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aigis.Foundation\Aigis.Foundation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- TASK-068 / §9.8.1: user-approved 2026-08-01, all four verified restorable on this
         machine before the plan was committed. OpenAL keeps the audio backend in the same
         family as the existing windowing/input/Vulkan bindings (Silk.NET); decoding is
         pure-managed (NVorbis/NLayer), so OpenAL Soft is the only native dependency and its
         own .Native package carries it. -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="2.0.1" />
  </ItemGroup>
</Project>
